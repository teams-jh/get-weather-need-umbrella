# 날씨 수집 (scripts/generate_weather.py)
# OPENWEATHER_API_KEY 가 없으면 모든 거점이 status="failed" 로 기록됩니다.
# KMA_SERVICE_KEY 가 함께 있으면 기상청을 이중으로 조회해 판정을 비교합니다.
# (비교 결과는 weather_compare.json 으로만 나가고 weather_all.json 에는 영향이 없습니다.)
OPENWEATHER_API_KEY=
KMA_SERVICE_KEY=

# 기준 수집 provider. 기본값은 openweather 이며 kma 로 전환할 수 있습니다.
# WEATHER_PROVIDER=openweather

# 거점 조회 병렬도. 기상청 포털 한도(30 tps)에 여유를 두고 잡습니다.
# WEATHER_FETCH_WORKERS=4

# 수집 실패 거점을 더미 프리셋으로 채웁니다. 로컬 개발과 UI 시연 전용이며,
# 상용 워크플로에서는 절대 설정하지 마십시오. 더미가 실제 날씨로 오인되면
# 사용자가 앱이 정상 동작한다고 오판합니다. 켜더라도 거점 status 가 "preset"
# 으로 남아 알림 발송 대상에서는 제외되고, 커버리지 검사가 실패합니다.
# WEATHER_ALLOW_PRESET=1

# 커버리지 경고 임계값. 성공률이 이 값 미만이면 수집 워크플로가 실패로 표시됩니다.
# 데이터 게시 자체를 막지는 않습니다.
# WEATHER_MIN_SUCCESS_RATIO=0.9

# 알림 발송 (scripts/run_notifications.py)
# 실발송 스위치. 기본값은 꺼짐이며, 꺼져 있으면 모의 발송만 수행합니다.
ENABLE_REAL_TOSS_PUSH=false
FIREBASE_SERVICE_ACCOUNT_KEY={}
# 위 환경변수 대신 파일로 줄 수도 있습니다 (기본값 serviceAccountKey.json).
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# 예보가 이보다 오래됐으면 발송하지 않습니다 (기본 6시간).
# MAX_WEATHER_AGE_SECONDS=21600

# 토스 파트너 API 는 서버 간 mTLS 로 호출합니다. 인증서 값 자체는 커밋하지 마십시오.
TOSS_MTLS_CERT_PATH=/run/secrets/toss-client.crt
TOSS_MTLS_KEY_PATH=/run/secrets/toss-client.key

# 인증 API 서버 (api/app.py). uvicorn 으로 띄울 때만 필요합니다.
SESSION_SECRET_KEY=CHANGE_ME
CORS_ALLOWED_ORIGINS=https://your-miniapp-host.example.com
TOSS_UNLINK_CALLBACK_SECRET=CHANGE_ME
# TOSS_API_BASE_URL=https://apps-in-toss-api.toss.im
